generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// USERS (staff + doctors — the frontend filters doctors by role_id)
// ─────────────────────────────────────────────────────────────
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  phone         String?
  role          String   @default("SUPER_ADMIN") // SUPER_ADMIN | DOCTOR | ...
  roleId        Int      @default(1) @map("role_id") // frontend treats role_id 2 = Doctor
  departmentId  String?  @map("department_id")
  designationId String?  @map("designation_id")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  department       Department?           @relation(fields: [departmentId], references: [id])
  designation      Designation?          @relation(fields: [designationId], references: [id])
  opdAppointments  OpdAppointment[]      @relation("ConsultantDoctor")
  consultationChgs OpdConsultationCharge[]
  refreshTokens    RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id                String    @id @default(cuid())
  tokenHash         String    @unique @map("token_hash")
  userId            String    @map("user_id")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────
// DEPARTMENT
// ─────────────────────────────────────────────────────────────
model Department {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  opdAppointments     OpdAppointment[]
  consultationCharges OpdConsultationCharge[]

  @@map("departments")
}

// ─────────────────────────────────────────────────────────────
// DESIGNATION (used by the OPD Doctors page)
// ─────────────────────────────────────────────────────────────
model Designation {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("designations")
}

// ─────────────────────────────────────────────────────────────
// PATIENT
// ─────────────────────────────────────────────────────────────
enum Gender {
  male
  female
  other
}

enum MaritalStatus {
  single
  married
  divorced
  widowed
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  O_POS
  O_NEG
  AB_POS
  AB_NEG
}

model Patient {
  id        String  @id @default(cuid())
  uhid      String  @unique @default(cuid())
  name      String
  email     String?
  phone     String?
  dob       DateTime?
  gender    Gender?
  maritalStatus MaritalStatus? @map("marital_status")
  bloodGroup    BloodGroup?    @map("blood_group")

  address String?
  city    String?
  state   String?

  adharNo             String? @map("adhar_no")
  insuranceProvider   String? @map("insurance_provider")
  insurancePolicyNo   String? @map("insurance_policy_no")

  emergencyContactName     String? @map("emergency_contact_name")
  emergencyContactPhone    String? @map("emergency_contact_phone")
  emergencyContactRelation String? @map("emergency_contact_relation")

  referredBy  String?
  occupation  String?
  nationality String?
  hospitalId  String? @map("hospital_id")

  allergies String?
  remarks   String?
  photo     String? @db.LongText

  status       String   @default("Active")
  registeredAt DateTime @default(now()) @map("registered_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital        Hospital?        @relation(fields: [hospitalId], references: [id])
  opdAppointments OpdAppointment[]

  @@map("patients")
}

// ─────────────────────────────────────────────────────────────
// OPD CHARGE CATEGORY + CONSULTATION CHARGE
// ─────────────────────────────────────────────────────────────
model OpdChargeCategory {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charges      OpdConsultationCharge[]
  appointments OpdAppointment[]

  @@map("opd_charge_categories")
}

model OpdConsultationCharge {
  id                 String  @id @default(cuid())
  name               String
  standardCharge     Float   @default(0)
  discountPercentage Float   @default(0)
  taxPercentage      Float   @default(0)
  isActive           Boolean @default(true)

  chargeCategoryId String
  departmentId      String?
  doctorId          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chargeCategory OpdChargeCategory @relation(fields: [chargeCategoryId], references: [id], onDelete: Cascade)
  department     Department?       @relation(fields: [departmentId], references: [id])
  doctor         User?             @relation(fields: [doctorId], references: [id])
  appointments   OpdAppointment[]

  @@map("opd_consultation_charges")
}

// ─────────────────────────────────────────────────────────────
// OPD APPOINTMENT
// ─────────────────────────────────────────────────────────────
model OpdAppointment {
  id            String @id @default(cuid())
  appointmentId String? // optional link back to a general appointment record
  opdNo         String? @unique
  caseId        String? @unique

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  appointmentDate DateTime

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  consultantDoctorId String?
  consultantDoctor   User?   @relation("ConsultantDoctor", fields: [consultantDoctorId], references: [id])

  reference   String?
  generatedBy String?

  isOldPatient       Boolean @default(false)
  isCasualty         Boolean @default(false)
  isAntenatal        Boolean @default(false)
  isLiveConsultation Boolean @default(false)

  symptomsType        String?
  symptomsTitle       String?
  symptomsDescription String?
  note                String?
  knownAllergies      String?
  previousMedicalIssue String?
  primaryDiagnosis    String?

  chargeCategoryId String?
  chargeCategory   OpdChargeCategory? @relation(fields: [chargeCategoryId], references: [id])
  chargeId         String?
  charge           OpdConsultationCharge? @relation(fields: [chargeId], references: [id])

  standardCharge     Float @default(0)
  appliedCharge      Float @default(0)
  discountPercentage Float @default(0)
  discountAmount     Float @default(0)
  taxPercentage      Float @default(0)
  taxAmount          Float @default(0)
  amount             Float @default(0)
  paidAmount         Float @default(0)
  paymentMode        String @default("cash")

  applyTpa Boolean @default(false)
  tpaId    String?

  status String @default("registered") // registered | completed | cancelled | inactive

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescription Prescription?

  @@map("opd_appointments")
}

// ─────────────────────────────────────────────────────────────
// PRESCRIPTION (1:1 with an OPD appointment)
// ─────────────────────────────────────────────────────────────
model Prescription {
  id               String @id @default(cuid())
  opdAppointmentId String @unique
  opdAppointment   OpdAppointment @relation(fields: [opdAppointmentId], references: [id], onDelete: Cascade)

  vitalSigns Json? // { bloodPressure, pulse, temperature, spo2, respiratoryRate, weight, height }
  medicines  Json? // [{ medicineId|medicine, dose, interval, duration, instruction, dispenseStatus }]
  radiologies Json? // [{ radiologyId, radiology:{testName}, status }]
  pathologies Json? // [{ testId, testName, status }]

  chiefComplaint  String?
  diagnosis       String?
  diagnosisCode   String?
  findingCategory String?
  findingList     String?
  findingDesc     String?

  advice       String?
  followUpDate DateTime?
  referredTo   String?

  headerNote String?
  footerNote String?
  status     String  @default("draft") // draft | final

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("prescriptions")
}

// ─────────────────────────────────────────────────────────────
// HOSPITAL (referenced by Patient.hospitalId in the patient form)
// ─────────────────────────────────────────────────────────────
model Hospital {
  id       String  @id @default(cuid())
  name     String
  address  String?
  phone    String?
  email    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patients Patient[]

  @@map("hospitals")
}

// ─────────────────────────────────────────────────────────────
// PATHOLOGY MASTER (test catalog referenced by prescriptions)
// ─────────────────────────────────────────────────────────────
model PathologyMaster {
  id       String  @id @default(cuid())
  testName String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pathology_master")
}
